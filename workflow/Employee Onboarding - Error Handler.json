      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const workflowName = $json.workflow?.name || \"unknown\";\nconst nodeName = $json.node?.name || \"unknown\";\nconst errorMessage = $json.error?.message || \"Unknown error\";\n\n// Classify severity by workflow name\nlet severity = \"medium\";\nif (workflowName.includes(\"WF-04\") || workflowName.includes(\"Provision\")) {\n  severity = \"critical\";\n} else if (workflowName.includes(\"WF-02\") || workflowName.includes(\"WF-03\")) {\n  severity = \"high\";\n} else if (workflowName.includes(\"WF-01\")) {\n  severity = \"high\";\n} else if (workflowName.includes(\"WF-06\")) {\n  severity = \"low\";\n}\n\nreturn [{\n  json: {\n    severity,\n    error_message: errorMessage,\n    stack_trace: $json.error?.stack || null,\n    n8n_workflow_id: $json.workflow?.id || null,\n    n8n_workflow_name: workflowName,\n    n8n_execution_id: $json.execution?.id || null,\n    node_name: nodeName,\n    request_id: $json.execution?.data?.resultData?.runData?.[\"WF-01 Set Request ID\"]?.[0]?.data?.main?.[0]?.[0]?.json?.request_id || null,\n    context: {\n      workflow: $json.workflow,\n      execution: $json.execution,\n      node: $json.node\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "ebfd7beb-f749-4be9-9e6a-94f266b0c12b",
